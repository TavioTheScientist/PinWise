# macOS
.DS_Store

# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/

# Generated by XcodeGen from App/project.yml — regenerate with `xcodegen generate`
*.xcodeproj/

# Private business strategy — kept local only, never in the (public) repo.
Knowledge/

# News feed build artifact — generated by scripts/build-feed.mjs and published by
# .github/workflows/news-feed.yml to the public PinWise-NewsFeed repo (not committed here).
feed/

# Supabase CLI scratch state — regenerated by `supabase link --project-ref <ref>`.
# Was tracked, which meant the project ref and pooler URL got re-committed on every CLI upgrade.
supabase/.temp/

# Claude Code machine-local state. `.claude/skills/` is a deliberate third-party install and is
# NOT ignored here — committing it is an open decision (it would share outside instructions with
# the team, and the MIT license is not currently vendored alongside it).
.claude/settings.local.json
.claude/scheduled_tasks.lock
