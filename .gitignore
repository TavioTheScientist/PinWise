# macOS
.DS_Store

# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/

# Generated by XcodeGen from App/project.yml — regenerate with `xcodegen generate`
*.xcodeproj/

# Private business strategy — kept local only, never in the (public) repo.
# The fact-checked knowledge base IS committed: four tracked source files cite
# `KnowledgeBase_v2/09_Clinical_Compound_Catalog_and_Safety_Data.md` as the provenance for the
# compound catalog (CompoundCatalog.swift, EvidenceTier.swift and their Dart ports), and a citation
# that resolves to nothing in every clone is worse than 296 KB of markdown.
#
# The loose scrape at the top of Knowledge/ is NOT committed — `awesome-ios-design-md.txt` (16 MB)
# and `swiftui-design-system-pro.txt` (708 KB) are third-party dumps referenced by no file in this
# repo. Git history is permanent; 16.7 MB of someone else's scraped docs is not worth making
# permanent to save a re-download.
Knowledge/*
!Knowledge/KnowledgeBase_v2/

# News feed build artifact — generated by scripts/build-feed.mjs and published by
# .github/workflows/news-feed.yml to the public PinWise-NewsFeed repo (not committed here).
feed/

# Supabase CLI scratch state — regenerated by `supabase link --project-ref <ref>`.
# Was tracked, which meant the project ref and pooler URL got re-committed on every CLI upgrade.
supabase/.temp/

# Claude Code machine-local state. `.claude/skills/` is a deliberate third-party install and is
# NOT ignored here — committing it is an open decision (it would share outside instructions with
# the team, and the MIT license is not currently vendored alongside it).
.claude/settings.local.json
.claude/scheduled_tasks.lock
